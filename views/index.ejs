<html>
  <head>
    <title>Mini Messge Board</title>
  </head>
  <body>
    <h1>home is where you are</h1>
    <p>God let me marry her</p>
    <button><a href="/new">New Message</a></button>

    <ul>
    <% messages.forEach((message) => { %>
        <li><strong><%= message.user %>:</strong> <%= message.text %> <a href="/message/<%= messages.indexOf(message) %>">[details]</a></li>
    <% }); %>
    </ul>

  </body>
</html>
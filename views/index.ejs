<html>
  <head>
    <title>Mini Messge Board</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <div class="header">
        <h1>Mini Messageboard</h1>
        <button class="new-message-button"><a href="/new">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            New Message
        </a></button>
    </div>

    <div class="messages">
        <ul class="messages-list">
        <% messages.forEach((message) => { %>

            <li class="message">
                <div class="message-header">
                    <h2><%= message.user %></h2>
                </div>

                <div class="message-content">
                    <p><%= message.text %> </p>
                </div>
                
                <div class="message-footer">
                    <p class="message-date"><%= message.added.toLocaleDateString() %></p>
                    <a class="message-detail" href="/message/<%= messages.indexOf(message) %>">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-icon lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </div>
            </li>

        <% }); %>
        </ul>
    </div>

  </body>
</html>